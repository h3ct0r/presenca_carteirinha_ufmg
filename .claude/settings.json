{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/config-builder/hooks/check-schema-sync.sh",
            "statusMessage": "Checking SD-card schema sync",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
